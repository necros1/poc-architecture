deployment {
    extend production.oci.ociRegion.ohsPersonas {
        rootPortalPersonaInstance = 
            instanceOf miPass.administracion.rootPortalPersona {
                #miPass
            }
    }
    extend production.oci.ociRegion.transversalOkeCluster.appNipp {
        miPerfilFrontendInstance = instanceOf miPass.administracion.miPerfilFrontend {#miPass}
        bffInstance = instanceOf miPass.administracion.bff {#miPass}
        miPerfilSeguridadInstance = instanceOf miPass.administracion.miPerfilSeguridad {#miPass}
        cajaDesafioWebUtilsInstance = instanceOf miPass.administracion.cajaDesafioWebUtils {#miPass}

        miPerfilSeguridadInstance
            -> production.onPrem.dataPowerGateway.apiConnectDomain.externalRestGateway 'Uses'
         
        bffInstance
            -> production.onPrem.dataPowerGateway.apiConnectDomain.externalRestGateway 'Uses'

        production.onPrem.dataPowerGateway.apiConnectDomain.externalRestGateway
            -> production.onPrem.serviceBus.emailServiceInstance

    }
    extend production.oci.ociRegion.transversalOkeCluster.crossSeguridad{
        securitySoftokenInstance =
            instanceOf securitySoftoken {
                #miPass
            }
    }
    extend production.onPrem.weblogicBus.serviceBus {
        emailServiceInstance = instanceOf emailService
    }
    extend production.onPrem.weblogicSecurity.securityServiceBus {
        validarDispositivoSeguridadInstance = instanceOf validarDispositivoSeguridad
        softokenInstance = instanceOf softoken
    }
    production.incapsula
        -> production.oci.ociRegion.ohsPersonas 'Routes traffic to'
}